{
  "name": "rsp-cpms-checking",
  "version": "4.0.0",
  "description": "Service to check the status of orphaned payments in CPMS",
  "repository": "https://github.com/dvsa/rsp-cpms-checking-workflow",
  "author": "",
  "license": "MIT",
  "engines": {
    "node": "^24.15.0",
    "npm": "^11.12.1"
  },
  "scripts": {
    "check-security": "git secrets --scan",
    "check-security-log": "git log -p | scanrepo",
    "prepush": "npm run lint && npm test && npm run check-security && npm run check-security-log",
    "test": "mocha --require ./test/register.js \"test/**/*.unit.js\"",
    "test:coverage": "c8 --all --include=\"src/**/*.js\" --per-file --check-coverage --lines 95 --functions 95 --branches 95 --statements 95 mocha --require ./test/register.js \"test/**/*.unit.js\"",
    "test:integration": "node test/integration/run.js",
    "lint": "./node_modules/.bin/eslint src",
    "lint:fix": "./node_modules/.bin/eslint src --fix",
    "watch": "./node_modules/.bin/nodemon --watch src --exec npm run build",
    "offline": "sls offline start --noAuth --localEnvironment",
    "parallel": "./node_modules/.bin/run-p watch offline",
    "build": "webpack-cli --config webpack.config.js",
    "start": "rm -rf build && npm run build && node --env-file-if-exists=.env ./node_modules/npm-run-all/bin/run-p watch offline",
    "build:prod": "rm -rf dist .webpack && webpack-cli --config webpack.production.js",
    "build:ci": "webpack-cli --config webpack.production.js"
  },
  "devDependencies": {
    "@babel/cli": "^7.19.3",
    "@babel/core": "^7.20.2",
    "@babel/preset-env": "^7.20.2",
    "@babel/register": "^7.18.9",
    "archiver": "^5.3.1",
    "babel-loader": "^9.1.0",
    "copy-webpack-plugin": "^14.0.0",
    "c8": "^12.0.0",
    "eslint": "^8.27.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.26.0",
    "expect": "^29.3.1",
    "fs-extra": "^10.1.0",
    "mocha": "^12.0.3",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "osls": "^4.9.0",
    "serverless-offline": "^14.8.5",
    "serverless-dotenv-plugin": "^6.0.0",
    "sinon": "^14.0.2",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-merge": "^5.10.0"
  },
  "dependencies": {
    "@babel/polyfill": "^7.4.0",
    "@aws-sdk/client-secrets-manager": "^3.1178.0",
    "aws4": "^1.11.0",
    "axios": "^1.7.4",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "url-parse": "^1.5.10"
  },
  "overrides": {
    "serverless": "npm:osls"
  }
}
